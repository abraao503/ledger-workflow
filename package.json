{
  "name": "@7agentes/workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Local workflow ledger and MCP server for agent-driven implementation",
  "type": "module",
  "bin": {
    "workflow": "dist/interfaces/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watch",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "dev:web": "tsx src/interfaces/web/main.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start:web": "NODE_ENV=production node dist/interfaces/web/main.js",
    "test:web": "vitest run",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "start:mcp": "node dist/interfaces/mcp/main.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@prisma/client": "^6.19.0",
    "commander": "^13.1.0",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "jsdom": "^29.1.1",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
